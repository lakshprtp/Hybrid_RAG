# ==========================================
# RAG System Environment Variables Template
# ==========================================

# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (Get at: https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Qdrant Vector Database Configuration
# Leave QDRANT_URL empty to use local embedded file storage (./qdrant_storage)
# To use Qdrant Cloud, provide the URL and API Key:
# QDRANT_URL=https://your-cluster-url.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_knowledge_base

# Gemini Model Configuration
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_GENERATION_MODEL=gemini-1.5-flash

# PostgreSQL Database URL for Chat Threads (Render Postgres, Supabase, Neon)
DATABASE_URL=

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
